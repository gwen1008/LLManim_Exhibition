# =============================================================================
# LLManim_Agent — .env.example
# Copy to .env and fill in. Ask the project owner for secret values.
# =============================================================================

# ── CORE: minimum keys to run the pipeline end-to-end ────────────────────────

# Vision QA (GPT-4o via OpenAI direct). REQUIRED for Vision verdict and FinalJudge phase-2.
OPENAI_API_KEY=

# Audio (Azure Cognitive Services TTS). REQUIRED if AUDIO_BACKEND=azure.
# Leave AUDIO_BACKEND=local to skip Azure (will use a local fallback TTS).
AUDIO_BACKEND=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Coder runs through Claude Code CLI (subscription, no API key).
# Set this if `claude` is not in your PATH:
# CLAUDE_BIN=/Users/<you>/.local/bin/claude

# Model routing (defaults work; override only when comparing variants).
PLANNER_MODEL=google/gemini-2.5-flash
CODER_MODEL=claude-opus-4-7
VISION_MODEL=gpt-4o

# ── ADVANCED: uncomment only if you need to tune ─────────────────────────────

# OpenRouter (fallback router used by Planner when PLANNER_MODEL is a 3rd-party slug)
# OPENROUTER_API_KEY=

# Groq / DeepSeek (legacy backends; not used by current default routing)
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com

# Extended thinking modes (verbose CoT — slower, higher quality)
# PLANNER_THINKING=1
# CODER_THINKING=1

# RAG (Weaviate). Defaults to ManimGoldenPair collection. Set DISABLE_RAG=1 to skip retrieval.
# RAG_COLLECTION=ManimGoldenPair
# DISABLE_RAG=0
# RAG_KB_DIR=./knowledge_base/examples

# FinalJudge tuning
# LLMANIM_FJ_PASSES=3              # number of vision passes
# FJ_VISION_BACKEND=gpt4o           # or opus
# FJ_OPUS_MODEL=claude-opus-4-7
# LLMANIM_DISABLE_FJ=0              # set to 1 to skip FinalJudge entirely

# BenchmarkJudge / PairwiseJudge (only used by evaluation pipeline)
# BENCHMARK_JUDGE_MODEL=claude-opus-4-7
# BENCHMARK_JUDGE_PASSES=3
# PAIRWISE_JUDGE_MODEL=claude-opus-4-7
# PAIRWISE_JUDGE_PASSES=3

# Azure voice override
# AZURE_VOICE=en-US-JennyNeural

# Coder CLI sandbox user (only relevant for the claudealt multi-account setup)
# CLAUDE_RUN_AS_USER=claudealt

# Evaluation output dir override
# EVAL_OUTPUT_DIR=stable_outputs
