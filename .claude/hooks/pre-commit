#!/bin/bash
# pre-commit: auto-stage HANDOFF.md if it has unstaged changes

PROJECT_DIR="$(git rev-parse --show-toplevel)"

f=".ai-context/HANDOFF.md"
full="$PROJECT_DIR/$f"
if [ -f "$full" ] && git status --short -- "$f" 2>/dev/null | grep -qE '^( M|\?\?)'; then
    git add "$full"
    echo "[pre-commit] staged $f"
fi

exit 0